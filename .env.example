# Modes:
# - demo: placeholder scores, UI rehearsal only.
# - validation: real checkpoints with a hash-bound but uncertified policy.
# - clinical: real checkpoints and an independently certified policy are mandatory.
APP_MODE=demo
PILOT_PHASE=silent
OFFLINE_ONLY=true
# Default false. Enable only on a hospital-approved isolated private LAN.
# When true, set HOST=0.0.0.0 and a non-empty APP_API_KEY.
ALLOW_PRIVATE_LAN=false
# Public HTTPS mode requires OFFLINE_ONLY=false, loopback HOST, an APP_API_KEY,
# and an APP_SESSION_SECRET with at least 32 characters.
PUBLIC_INTERNET_MODE=false
APP_API_KEY=
APP_SESSION_SECRET=
ACCESS_SESSION_HOURS=8
AUTH_MAX_FAILURES=5
AUTH_WINDOW_SECONDS=900
PERSIST_IMAGES=true
IMAGE_STORE_DIR=runtime/hospital_offline/images

# Use comma-separated paths for the frozen five-fold ensemble.
MODEL_VERSION=selectivenet-cost5-ensemble-v1
MODEL_CHECKPOINTS=/weights/cost_5.0_fold_1_LAST.pth,/weights/cost_5.0_fold_2_LAST.pth,/weights/cost_5.0_fold_3_LAST.pth,/weights/cost_5.0_fold_4_LAST.pth,/weights/cost_5.0_fold_5_LAST.pth
POLICY_PATH=/weights/deployment_policy.cost5.validation.json
MODEL_DEVICE=cpu

TILE_BATCH_SIZE=16
MAX_TILES=1024
MAX_UPLOAD_MB=100
MAX_IMAGE_PIXELS=200000000
MAX_IMAGES_PER_CASE=300
MAX_CASE_UPLOAD_MB=1000
